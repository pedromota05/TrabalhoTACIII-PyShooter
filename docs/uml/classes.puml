@startuml
title Diagrama de Classes — PyShooter
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
top to bottom direction

package "Aplicação" {
  class Game {
    +run()
    -_load_level(level_number)
  }

  enum GameState {
    MENU
    INSTRUCTIONS
    LEVEL_SELECT
    PLAYING
    PAUSE
    OPTIONS
    GAME_OVER
    LEVEL_TRANSITION
  }

  class AssetManager {
    +load_all()
    +get_image(name)
    +get_sound(name)
  }
  class Button
}

package "Mundo" {
  class World {
    +obstacle_list
    +ramp_list
    +level_length
    +process_data(data, ..., level)
    +draw(screen, screen_scroll)
  }
}

package "Entidades" {
  class "pygame.sprite.Sprite" as Sprite <<external>>

  package "Personagens" {
    class Character {
      +move()
      +shoot(bullet_group)
      +update()
      +draw(screen)
    }
    class Player {
      +jump()
      +move()
      +update()
    }
  }

  package "Inimigos" {
    class Enemy { +ai() }
    class Sniper
    class RobotEnemy { +ai() }
    class SkeletonEnemy { +ai() }
    class DragonBoss { +update() }
    class Boss { +update() }
  }

  package "Combate" {
    class Bullet
    class SniperBullet
    class RobotBullet
    class Arrow
    class Grenade
    class Explosion
    class DragonFire
  }

  package "Cenário" {
    class ItemBox
    class Decoration
    class Water
    class Exit
  }
}

package "Interface" {
  class HealthBar { +draw(screen, health) }
  class ScreenFade { +fade(screen) }

  package "Telas" {
    class MainMenuScreen { +draw(game) }
    class InstructionsScreen { +draw(game) }
    class OptionsScreen { +draw(game) }
    class LevelSelectScreen { +draw(game) }
    class PauseOverlay { +draw(game) }
    class GameOverScreen { +draw(game) }
  }
}

' Heranças
Sprite <|-- Character
Character <|-- Player
Character <|-- Enemy
Enemy <|-- Sniper
Character <|-- RobotEnemy
Character <|-- SkeletonEnemy

Sprite <|-- DragonBoss
Sprite <|-- Boss
Sprite <|-- Bullet
Sprite <|-- SniperBullet
Sprite <|-- RobotBullet
Sprite <|-- Arrow
Sprite <|-- Grenade
Sprite <|-- Explosion
Sprite <|-- DragonFire
Sprite <|-- ItemBox
Sprite <|-- Decoration
Sprite <|-- Water
Sprite <|-- Exit

' Orquestração da sessão
Game *-- AssetManager : assets
Game *-- GameState : state
Game *-- World : world
Game *-- Player : player
Game *-- HealthBar : health_bar
Game *-- ScreenFade : intro_fade
Game *-- "0..*" Sprite : grupos
Game o-- "telas" MainMenuScreen

note right of World
  process_data cria Player, HealthBar,
  inimigos, chefes, itens e elementos
  de cenário a partir do CSV da fase.
end note

' Relações de combate
Player ..> Bullet : dispara
Player ..> Grenade : lança
Enemy ..> Bullet : dispara
Sniper ..> SniperBullet : dispara
RobotEnemy ..> RobotBullet : dispara
SkeletonEnemy ..> Arrow : dispara
DragonBoss ..> DragonFire : dispara
Grenade ..> Explosion : gera

' Telas que usam botões; setas ocultas mantêm as telas alinhadas.
MainMenuScreen ..> Button
MainMenuScreen -[hidden]-> InstructionsScreen
InstructionsScreen -[hidden]-> OptionsScreen
OptionsScreen -[hidden]-> LevelSelectScreen
LevelSelectScreen -[hidden]-> PauseOverlay
PauseOverlay -[hidden]-> GameOverScreen
@enduml
