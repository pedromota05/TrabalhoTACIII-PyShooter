@startuml
title Diagrama de Classes — PyShooter (Atualizado Trabalho 2)
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam linetype ortho
top to bottom direction

package "Aplicação" {
  class Game <<Facade>> {
    +is_multiplayer: bool
    +run()
    +start_multiplayer_host(port)
    +start_multiplayer_client(ip, port)
    +clean_multiplayer()
    -_load_level(level_number)
  }

  enum GameState <<State>> {
    MENU
    INSTRUCTIONS
    LEVEL_SELECT
    PLAYING
    PAUSE
    OPTIONS
    GAME_OVER
    LEVEL_TRANSITION
    MULTIPLAYER_MENU
    EDITOR
  }

  class AssetManager <<Singleton>> {
    -_instance: AssetManager
    +load_all()
    +get_image(name)
    +get_sound(name)
    +load_character_animations(char_type, scale)
  }
  class Button
}

package "Rede (Multiplayer LAN)" {
  class GameServer {
    +host: str
    +port: int
    +running: bool
    +start(): bool
    +stop()
    -_run_loop()
  }

  class NetworkClient {
    +player_id: str
    +server_ip: str
    +server_port: int
    +running: bool
    +connect(): bool
    +send_state(x, y, action, dir, shooting, hp)
    +update_interpolation()
    +get_remote_players_snapshot()
    +disconnect()
  }

  class Protocol {
    +encode_player_state(...)
    +encode_disconnect(...)
    +encode_remove(...)
    +parse_packet(...)
  }
}

package "Mundo" {
  class World <<Factory Method>> {
    +obstacle_list
    +ramp_list
    +level_length
    +process_data(data, ..., level)
    +draw(screen, screen_scroll)
  }
}

package "Entidades" {
  class "pygame.sprite.Sprite" as Sprite <<external>>

  package "Personagens" {
    class Character {
      +health: int
      +alive: bool
      +move()
      +shoot(bullet_group)
      +update()
      +draw(screen)
    }
    class Player {
      +invincible: int
      +jump()
      +move()
      +update()
    }
    class RemotePlayer <<Proxy>> {
      +player_id: str
      +world_x: float
      +world_y: float
      +update_from_network(data, bg_scroll, bullet_group)
      +draw(screen)
    }
  }

  package "Inimigos" {
    class Enemy { +ai() }
    class Sniper
    class RobotEnemy { +ai() }
    class SkeletonEnemy { +ai() }
    class DragonBoss { +update() }
    class Boss { +update() }
  }

  package "Combate" {
    class Bullet
    class SniperBullet
    class RobotBullet
    class Arrow
    class Grenade
    class Explosion
    class DragonFire
  }

  package "Cenário" {
    class ItemBox
    class Decoration
    class Water
    class Exit
  }
}

package "Interface" {
  class HealthBar { +draw(screen, health) }
  class ScreenFade { +fade(screen) }

  package "Telas" {
    class MainMenuScreen { +update(screen, game) }
    class MultiplayerMenuScreen { +update(screen, game); +handle_event(event) }
    class LevelEditorScreen { +update(screen, game); +handle_event(event, game); +save_level_data(); +load_level_data(level) }
    class InstructionsScreen { +update(screen, game) }
    class OptionsScreen { +update(screen, game) }
    class LevelSelectScreen { +update(screen, game) }
    class PauseOverlay { +update(screen, game) }
    class GameOverScreen { +update(screen, game) }
  }
}

' Heranças
Sprite <|-- Character
Sprite <|-- RemotePlayer
Character <|-- Player
Character <|-- Enemy
Enemy <|-- Sniper
Character <|-- RobotEnemy
Character <|-- SkeletonEnemy

Sprite <|-- DragonBoss
Sprite <|-- Boss
Sprite <|-- Bullet
Sprite <|-- SniperBullet
Sprite <|-- RobotBullet
Sprite <|-- Arrow
Sprite <|-- Grenade
Sprite <|-- Explosion
Sprite <|-- DragonFire
Sprite <|-- ItemBox
Sprite <|-- Decoration
Sprite <|-- Water
Sprite <|-- Exit

' Orquestração da sessão
Game *-- AssetManager : assets
Game *-- GameState : state
Game *-- World : world
Game *-- Player : player
Game *-- HealthBar : health_bar
Game *-- ScreenFade : intro_fade
Game *-- "0..*" Sprite : grupos
Game o-- GameServer : network_server
Game o-- NetworkClient : network_client
Game o-- "telas" MainMenuScreen
Game o-- "telas" MultiplayerMenuScreen
Game o-- "telas" LevelEditorScreen

' Rede
NetworkClient ..> Protocol
GameServer ..> Protocol
Game ..> RemotePlayer : instancia ao receber pacotes

note right of World
  Factory Method: process_data cria Player,
  HealthBar, inimigos, chefes, itens e elementos
  de cenário a partir da matriz CSV da fase.
end note

' Relações de combate
Player ..> Bullet : dispara
RemotePlayer ..> Bullet : dispara
Player ..> Grenade : lança
Enemy ..> Bullet : dispara
Sniper ..> SniperBullet : dispara
RobotEnemy ..> RobotBullet : dispara
SkeletonEnemy ..> Arrow : dispara
DragonBoss ..> DragonFire : dispara
Grenade ..> Explosion : gera

' Telas que usam botões
MainMenuScreen ..> Button
MultiplayerMenuScreen ..> Button
LevelEditorScreen ..> Button
@enduml
