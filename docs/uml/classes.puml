@startuml
!pragma layout smetana
title Diagrama de Classes (1/2) — Aplicação, Rede, Mundo e Interface
skinparam classAttributeIconSize 0
skinparam packageStyle rectangle
skinparam shadowing false
skinparam defaultFontName Arial
skinparam class {
  BackgroundColor #EAF1FB
  BorderColor #2E5C9A
}

package "Aplicação" {
  class Game <<Facade>> {
    +is_multiplayer: bool
    +challenge_mode: bool
    +run()
    +start_multiplayer_host(port)
    +start_multiplayer_client(ip, port)
    +start_challenge(start_index)
    +clean_multiplayer()
  }
  enum GameState <<State>> {
    MENU
    INSTRUCTIONS
    LEVEL_SELECT
    PLAYING
    PAUSE
    OPTIONS
    GAME_OVER
    LEVEL_TRANSITION
    VICTORY
    MULTIPLAYER_MENU
    EDITOR
  }
  class AssetManager <<Singleton>> {
    -_instance: AssetManager
    +load_all()
    +get_image(name)
    +get_sound(name)
    +load_character_animations(tipo, escala)
  }
  class Button
  class MusicPlayer {
    +tocar(caminho, game)
    +vinheta(chave, game)
    +update(game)
  }
}

package "Rede (Multiplayer LAN)" {
  class GameServer {
    +port: int
    +start(): bool
    +stop()
    -_run_loop()
  }
  class NetworkClient {
    +player_id: str
    +connect(): bool
    +send_state(...)
    +update_interpolation()
    +disconnect()
    -_receive_loop()
  }
  class "protocol" as Protocol <<módulo>> {
    +encode_player_state(...)
    +encode_enemies_state(...)
    +encode_level(...)
    +encode_wave(...)
    +parse_packet(msg)
  }
}

package "Mundo" {
  class World <<Factory Method>> {
    +obstacle_list
    +crates
    +boss_gate_tiles
    +process_data(data, ...)
    +open_boss_gate()
    +draw(screen, scroll)
  }
}

package "Interface" {
  class HealthBar {
    +draw(screen, health)
  }
  class ScreenFade {
    +fade(screen)
  }
  class ColorPicker {
    +handle_click(pos)
  }
  package "Telas (ui/screens)" {
    class MainMenuScreen
    class LevelSelectScreen
    class MultiplayerMenuScreen
    class LevelEditorScreen {
      +handle_event(event, game)
      +save_level_data()
      +load_level_data(level)
    }
    class InstructionsScreen
    class OptionsScreen
    class PauseOverlay
    class GameOverScreen
    class VictoryScreen
  }
}

Game *-- AssetManager
Game *-- GameState
Game *-- World
Game *-- HealthBar
Game *-- ScreenFade
Game *-- MusicPlayer
Game o-- GameServer
Game o-- NetworkClient
Game o-- MainMenuScreen : telas (uma por GameState)
MainMenuScreen -[hidden]down- LevelSelectScreen
LevelSelectScreen -[hidden]down- MultiplayerMenuScreen
InstructionsScreen -[hidden]down- OptionsScreen
OptionsScreen -[hidden]down- PauseOverlay
GameOverScreen -[hidden]down- VictoryScreen
VictoryScreen -[hidden]down- LevelEditorScreen
NetworkClient ..> Protocol
GameServer ..> Protocol
LevelSelectScreen ..> ColorPicker
MultiplayerMenuScreen ..> ColorPicker
MainMenuScreen ..> Button
MultiplayerMenuScreen ..> Button
LevelEditorScreen ..> Button
@enduml
