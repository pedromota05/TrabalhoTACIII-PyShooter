@startuml
title Arquitetura de Pacotes — PyShooter (Atualizado Trabalho 2)
top to bottom direction
skinparam packageStyle rectangle
skinparam nodesep 40
skinparam ranksep 50

package "Aplicação" {
    ["main.py"] as main
    ["game.py\nGame <<Facade>>"] as game
    ["game_state.py\nGameState <<State>>"] as game_state
    ["config.py"] as config
    ["asset_manager.py\nAssetManager <<Singleton>>"] as assets
    ["button.py\nButton"] as button
}

package "Rede (Multiplayer LAN)" {
    package "network" {
        ["protocol\nSerialização UDP"] as net_proto
        ["server\nGameServer"] as net_server
        ["client\nNetworkClient"] as net_client
    }
}

package "Core & World" {
    package "core" {
        [input_handler] as input
        [gameplay] as gameplay
        [level_loader] as loader
        [renderer] as renderer
    }
    package "world" {
        ["level_builder\nWorld <<Factory Method>>"] as world_comp
    }
}

package "Entities" {
    package "entities" {
        ["base\nCharacter"] as entity_base
        ["player\nPlayer"] as player
        ["remote_player\nRemotePlayer <<Proxy>>"] as remote_player

        package "enemies" {
            ["standard\nEnemy, Sniper"] as enemy_standard
            ["robot\nRobotEnemy"] as enemy_robot
            ["skeleton\nSkeletonEnemy"] as enemy_skeleton
            ["bosses\nBoss, DragonBoss"] as enemy_bosses
        }

        package "combat" {
            [projectiles] as projectiles
        }

        ["items\nItemBox"] as items
        ["environment\nDecoration, Water, Exit"] as environment
    }
}

package "UI" {
    package "ui" {
        ["hud\nHealthBar"] as hud
        ["transitions\nScreenFade"] as transitions

        package "screens" {
            [menu] as menu
            [multiplayer_menu] as multi_menu
            [level_editor] as editor_screen
            [instructions] as instructions
            [options] as options
            [level_select] as level_select
            [pause] as pause
            [game_over] as game_over
            [common] as common
        }
    }
}

folder "levels/\nCSVs das fases" as levels
folder "img/ e audio/\nrecursos" as resources

' Conexões Principais de Fluxo
main --> game : inicia
game --> input
game --> gameplay
game --> loader
game --> renderer
game --> transitions

' Fluxo de Rede
game --> net_server : gerencia host
game --> net_client : sincroniza estado
net_client ..> net_proto : codifica/decodifica
net_server ..> net_proto : gerencia pacotes
gameplay --> remote_player : interpola LERP

' Fluxo UI
game --> menu
game --> multi_menu
game --> editor_screen
game --> instructions
game --> options
game --> level_select
game --> pause
game --> game_over

' Editor de Fases
editor_screen ..> levels : salva/carrega CSV

' Dependências Core e World
loader --> world_comp : instancia
loader ..> levels : lê
world_comp --> player
world_comp --> enemy_standard
world_comp --> enemy_robot
world_comp --> enemy_skeleton
world_comp --> enemy_bosses
world_comp --> items
world_comp --> environment
world_comp --> hud

' Entidades e Combate
player --> entity_base
remote_player --> projectiles : sincroniza disparos
enemy_standard --> entity_base
enemy_robot --> entity_base
enemy_skeleton --> entity_base
gameplay --> projectiles
enemy_bosses --> projectiles

' Recursos
assets ..> resources : carrega
@enduml
